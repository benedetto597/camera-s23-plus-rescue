<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.s23plus.camera"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="34" />

    <!-- Permiso para usar las camaras frontales ID 1 (12MP) e ID 3 (8.6MP) via Camera2 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Sin permiso INTERNET: aplicacion 100% offline y privada por diseno -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <queries>
        <package android:name="com.sec.android.app.camera" />
        <intent>
            <action android:name="com.sec.android.app.camera.action.SCAN_QR_CODE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="S23+ Camera"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RearCaptureService"
            android:exported="true"
            android:label="S23+ Obturador Trasero (ID 56)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
